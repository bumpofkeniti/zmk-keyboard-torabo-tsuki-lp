#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/* もともとある設定の書き換え */
&pointing_listener {
    input-processors = 
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>;

    /* 誤動作を防ぎつつ、動く向きも正しく修正 */
    automouse {
        layers = <0 1 2 3 4 5>;
        input-processors = 
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
            <&zip_xy_scaler 1 2>, 
            <&zip_temp_layer 5 1500>;
    };

    /* 👇 修正：レイヤー3を廃止し、レイヤー6のときだけスクロールにする設定 */
    scroller {
        layers = <6>; /* 👈 3を消して 6 だけに指定しました */
        input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 1>;
    };
};

/* エラーの原因になっている古い命令を、空っぽにして無効化（上書き）する */
/ {
    /delete-property/ automouse-layer;
};

&size_s_transform {
    col-offset = <7>;
};

&size_m_transform {
    col-offset = <7>;
};

&size_l_transform {
    col-offset = <7>;
};
