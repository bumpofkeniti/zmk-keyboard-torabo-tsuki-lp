#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/* &pointing_listener の中身を調整し、キー入力との連動ガードを設定します */
&pointing_listener {
    input-processors = 
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
        <&zip_xy_scaler 1 2>, 
        /* 👇 変更点：&zip_temp_layer を &zip_smart_layer に置き換え */
        <&zip_smart_layer 5 1500 500>; 
        
    /* レイヤー6のときだけスクロールにする設定（4分の1速度） */
    scroller {
        layers = <6>;
        input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 4>;
    };
};

/* エラーの原因になっている古い命令を、空っぽにして無効化（上書き）する */
/ {
    /delete-property/ automouse-layer;
};

&size_s_transform {
    col-offset = <7>;
};

&size_m_transform {
    col-offset = <7>;
};

&size_l_transform {
    col-offset = <7>;
};
