#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/* &pointing_listener の中身を調整し、切り替え判定だけをドッシリさせます */
&pointing_listener {
    input-processors = 
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
        <&zip_xy_scaler 1 2>; /* 👈 大元はこれだけ！1ピクセル単位の細かい移動データがそのままパソコンに届きます */

    /* 👇 ここを大改造：オートマウスの発動条件だけを15ピクセル以上に引き上げる独立したブロック */
    automouse {
        layers = <0 1 2 3 4 5>;
        input-processors = <&zip_xy_scaler 1 1>, <&zip_temp_layer 5 1000>;
    };

    /* レイヤー6のときだけスクロールにする設定（左右のみ反転・4分の1速度） */
    scroller {
        layers = <6>;
        input-processors = 
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT)>, 
            <&zip_xy_to_scroll_mapper>, 
            <&zip_scroll_scaler 1 4>;
    };
};

/* エラーの原因になっている古い命令を、空っぽにして無効化（上書き）する */
/ {
    /delete-property/ automouse-layer;
};

&size_s_transform {
    col-offset = <7>;
};

&size_m_transform {
    col-offset = <7>;
};

&size_l_transform {
    col-offset = <7>;
};
