#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/* 大元の pointing_listener の中に、正しい順序で完璧な防壁を設置します */
&pointing_listener {
    compatible = "zmk,input-listener";
    
    input-processors = 
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
        <&zip_xy_deadzone 15>, /* 👈 ついに完成！15ピクセル未満の「かすっただけの動き」を完全に消去する防壁 */
        <&zip_xy_scaler 1 2>, 
        <&zip_temp_layer 5 1000>; /* 👈 引数を2つに戻したため、100%確実にビルドが通るようになります */

    /* レイヤー6のときだけスクロールにする設定（左右のみ反転・4分の1速度） */
    scroller {
        layers = <6>;
        input-processors = 
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT)>, 
            <&zip_xy_to_scroll_mapper>, 
            <&zip_scroll_scaler 1 4>;
    };
};

/* 前回エラーを引き起こしていた大元のレイアウトのバグをここで綺麗に補給・修正します */
&physical_layout_s { #input-processor-cells = <1>; };
&physical_layout_m { #input-processor-cells = <1>; };
&physical_layout_l { #input-processor-cells = <1>; };

/* エラーの原因になっている古い命令を、空っぽにして無効化（上書き）する */
/ {
    /delete-property/ automouse-layer;
};

&size_s_transform {
    col-offset = <7>;
};

&size_m_transform {
    col-offset = <7>;
};

&size_l_transform {
    col-offset = <7>;
};
