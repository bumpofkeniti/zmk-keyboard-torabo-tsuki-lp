#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/* もともとある設定の書き換え */
&pointing_listener {
    input-processors = 
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>;

    /* 誤動作を防ぐ壁（1/2縮小）を挟みつつ、全レイヤーで発動するように修正 */
    automouse {
        layers = <0 1 2 3 4 5>; /* 👈 エラー解決のために追加：全レイヤーを指定 */
        input-processors = <&zip_xy_scaler 1 2>, <&zip_temp_layer 5 1500>;
    };

    /* レイヤー3のときだけスクロールにする設定 */
    scroller {
        layers = <3>;
        input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 1>;
    };
};

/* エラーの原因になっている古い命令を、空っぽにして無効化（上書き）する */
/ {
    /delete-property/ automouse-layer;
};

&size_s_transform {
    col-offset = <7>;
};

&size_m_transform {
    col-offset = <7>;
};

&size_l_transform {
    col-offset = <7>;
};
