#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h> 

/* トラックボールの入力処理設定 */
&pointing_listener {
input-processors =
<&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
<&zip_xy_scaler 1 2>, /* 👈 ここに追記：速度を1/2（1000DPI相当）に落とす設定 */
<&zip_temp_layer 5 1500>; 

/* レイヤー3のときだけスクロールにする設定 */
scroller {
layers = <3>;
input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 1>;
};
}; 

/* 古い命令を無効化（上書き） */
/ {
/delete-property/ automouse-layer;
}; 

&size_s_transform {
col-offset = <7>;
}; 

&size_m_transform {
col-offset = <7>;
}; 

&size_l_transform {
col-offset = <7>;
};

